# One key serves the whole project — the Next.js app and the Python backend
# both read OPENAI_API_KEY, and both default to the same models.
OPENAI_API_KEY=sk-proj-...

# Optional. Defaults match backend/app/config.py so the two services stay in step.
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# The Python knowledge service in fastAPI_chatbot/. /chat proxies to it — start it
# with `python -m uvicorn app.main:app --port 8000` from that folder. If it is not
# running the chat tab still answers, but ungrounded and with no bin results.
CHATBOT_URL=http://127.0.0.1:8000
