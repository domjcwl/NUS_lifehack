# One key serves the whole project — the Next.js app and the Python backend
# both read OPENAI_API_KEY, and both default to the same models.
OPENAI_API_KEY=sk-proj-...

# Optional. Defaults match backend/app/config.py so the two services stay in step.
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
