root = true

# Four people are on main. Editor defaults differ; this stops indentation from
# becoming a diff. The codebase is already uniformly 2-space — this keeps it so
# rather than reformatting anything.
[*]
indent_style = space
indent_size = 2
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Trailing double-space is a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{py,json,geojson}]
indent_size = 2

[*.py]
indent_size = 4
